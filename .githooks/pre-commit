#!/bin/sh
# Pre-commit hook: runs lint, type check, build, and tests
# Catches issues before they fail in CI

set -e

echo "🔍 Running pre-commit checks..."

# Run from repo root
cd "$(git rev-parse --show-toplevel)"

echo ""
echo "📝 Running lint..."
bun run lint

echo ""
echo "🔨 Running build..."
bun run build

echo ""
echo "🧪 Running tests..."
bun run test

echo ""
echo "✅ All checks passed!"
