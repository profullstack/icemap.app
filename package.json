{
  "name": "icemap.app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @icemap/web dev",
    "build": "bun --filter @icemap/web build",
    "start": "bun --filter @icemap/web start",
    "lint": "bun --filter @icemap/web lint",
    "typecheck": "bun --filter @icemap/web typecheck",
    "test": "bun --filter @icemap/web test",
    "prepare": "git config core.hooksPath .githooks || true",
    "generate-user": "cd apps/web && bun ../../scripts/generate-user.ts",
    "postinstall": "bunx @socketsecurity/socket-patch apply --silent --ecosystems npm",
    "dependencies": "bunx @socketsecurity/socket-patch apply --silent --ecosystems npm"
  },
  "trustedDependencies": [
    "bcrypt",
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
